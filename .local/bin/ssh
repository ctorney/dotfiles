
#!/usr/bin/env bash

if [ -n "${TMUX:-}" ]; then
    osascript - "$@" <<'APPLESCRIPT'
on run argv
    set sshCommand to "/usr/bin/ssh -L localhost:6666:localhost:6666"
    repeat with a in argv
        set sshCommand to sshCommand & space & quoted form of (contents of a)
    end repeat

    tell application "Ghostty"
        activate

        if (count of windows) is 0 then
            new window
        end if

        set newTab to new tab in front window
    end tell

    delay 0.1

    tell application "System Events"
        keystroke sshCommand
        key code 36
    end tell
end run
APPLESCRIPT
else
    exec /usr/bin/ssh "$@"
fi
